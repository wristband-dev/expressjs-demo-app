{
  "name": "expressjs-demo-app--backend",
  "description": "Express backend server that handles all API requests coming from the React frontend.",
  "author": "Wristband",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=9.6.0"
  },
  "main": "server.ts",
  "scripts": {
    "build": "tsc",
    "dev": "nodemon",
    "typecheck": "tsc --noEmit",
    "reset-db": "ts-node reset-db.ts",
    "start": "NODE_ENV=production PORT=6001 tsx -r dotenv/config server.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "@wristband/express-auth": "^6.1.0",
    "agentkeepalive": "^4.6.0",
    "axios": "^1.13.6",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.2.1",
    "express-validator": "^7.3.1",
    "lowdb": "^1.0.0",
    "stoppable": "^1.1.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/lowdb": "^1.0.15",
    "@types/node": "^24.8.1",
    "@types/stoppable": "^1.1.3",
    "@types/validator": "^13.15.3",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "eslint": "^10.1.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.5",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  }
}
